+            return GoalVerification.succeeded()
+        return GoalVerification.failed(GoalFailureReason.OUTCOME_NOT_VERIFIED)
+
+    binding = ExecutableGoalBinding('pokemon.red:retained-lorelei-dialogue:' + state_hash,
